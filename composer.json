{
    "name": "indianopinion/meta-writer",
    "description": "WordPress plugin that drafts an SEO title and meta description from the post body, holds them for review, respects length limits and manual values, and writes only accepted text to the fields your SEO plugin reads.",
    "type": "wordpress-plugin",
    "license": "MIT",
    "keywords": ["wordpress", "seo", "meta description", "seo title", "llm", "yoast", "rank-math", "seopress", "wp-cli"],
    "homepage": "https://github.com/IndianOpinion/meta-writer",
    "support": {
        "issues": "https://github.com/IndianOpinion/meta-writer/issues",
        "source": "https://github.com/IndianOpinion/meta-writer",
        "email": "hello@indianopinion.org"
    },
    "authors": [
        {
            "name": "Indian Opinion",
            "email": "hello@indianopinion.org",
            "homepage": "https://indianopinion.org"
        }
    ],
    "repositories": [
        {
            "type": "vcs",
            "url": "https://github.com/IndianOpinion/llm-json-php"
        }
    ],
    "require": {
        "php": ">=8.1",
        "ext-json": "*",
        "ext-mbstring": "*",
        "indianopinion/llm-json-php": "^0.1"
    },
    "require-dev": {
        "php-stubs/wordpress-stubs": "^6.4",
        "php-stubs/wp-cli-stubs": "^2.10",
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^10.5",
        "squizlabs/php_codesniffer": "^4.0"
    },
    "suggest": {
        "ext-intl": "Counts lengths in grapheme clusters through the intl extension."
    },
    "autoload": {
        "psr-4": {
            "IndianOpinion\\MetaWriter\\": "src/"
        },
        "files": [
            "src/functions.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "IndianOpinion\\MetaWriter\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "analyse": "phpstan analyse --no-progress --memory-limit=1G",
        "lint": "phpcs",
        "check": ["@lint", "@analyse", "@test"]
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable"
}
